# Accelerando Hailstone board configuration

if BOARD_ACCELERANDO_HAILSTONE

config BOARD_ENABLE_DCDC
	bool "Enable DCDC mode"
	select SOC_DCDC_NRF52X
	default y
	depends on BOARD_ACCELERANDO_HAILSTONE

config BOARD_ENABLE_DCDC_HV
	bool "High Voltage DCDC converter"
	select SOC_DCDC_NRF52X_HV
	default y

endif # BOARD_ACCELERANDO_HAILSTONE