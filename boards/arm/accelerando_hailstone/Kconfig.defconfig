# Accelerando Hailstone (with eByte E73-2G4M08S1C nrf52840 System-on-module) configuration

if BOARD_ACCELERANDO_HAILSTONE

config BOARD
	default "accelerando_hailstone"

config BT_CTLR
	default BT

endif # BOARD_ACCELERANDO_HAILSTONE

if USB_DEVICE_STACK

config UART_CONSOLE
	default CONSOLE

config USB_DEVICE_INITIALIZE_AT_BOOT
	default y

endif # USB_DEVICE_STACK


