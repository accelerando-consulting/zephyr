# Accelerando Corinda board configuration

config BOARD
	default "accelerando_corinda"
	depends on BOARD_ACCELERANDO_CORINDA

config HEAP_MEM_POOL_ADD_SIZE_BOARD
	int
	default 65535 if WIFI && BT
	default 51200 if WIFI
	default 40960 if BT
	default 4096

choice BT_HCI_BUS_TYPE
	default BT_ESP32 if BT
endchoice
